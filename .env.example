# Copy to .env and adjust as needed.

# Where to bind the backend. Use 127.0.0.1 for local-only (default).
HOST=127.0.0.1
PORT=3000

# Where ws-scrcpy is reachable from the browser. The dashboard iframes this.
WS_SCRCPY_URL=http://localhost:8000

# ADB target. Empty = default (single device). For Redroid: 127.0.0.1:5555.
ADB_SERIAL=

# Backend type. Auto-detected if empty: "avd" on macOS, "redroid" if a redroid container is running.
# Override: avd | redroid
BACKEND_TYPE=

# Path to adb. Empty = first one in PATH.
ADB_PATH=

# Path to emulator console auth token (AVD only). Default: ~/.emulator_console_auth_token
EMULATOR_AUTH_TOKEN_PATH=
