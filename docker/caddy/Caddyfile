# Edge for the headless-android stack.
#
# Listeners:
#   :443   -> backend dashboard (HTTPS, basic auth)
#   :8443  -> ws-scrcpy        (HTTPS, basic auth, iframed by the dashboard)
#   :80    -> redirect to :443
#
# TLS is Caddy's "internal" CA (LAN-only). To avoid the browser warning,
# install Caddy's root cert in your trust store. The cert lives inside the
# container at /data/caddy/pki/authorities/local/root.crt; pull it with:
#   docker exec headless-caddy cat /data/caddy/pki/authorities/local/root.crt > caddy-root.crt
#
# Basic-auth username and password come from env (see docker/.env.example):
#   AUTH_USER         - cleartext username
#   AUTH_HASHED_PASS  - bcrypt hash. Generate with:
#                         docker run --rm caddy:2-alpine caddy hash-password --plaintext '<your-pw>'

{
	auto_https disable_redirects
	local_certs
}

# Dashboard (and /api/*) -- internal TLS, basic auth.
:443 {
	tls internal

	basic_auth {
		{$AUTH_USER} {$AUTH_HASHED_PASS}
	}

	reverse_proxy backend:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host  {host}
	}
}

# ws-scrcpy live screen iframe. Same auth realm so the browser reuses
# the dashboard credentials when the iframe loads.
:8443 {
	tls internal

	basic_auth {
		{$AUTH_USER} {$AUTH_HASHED_PASS}
	}

	reverse_proxy ws-scrcpy:8000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host  {host}
	}
}

# Redirect plain HTTP to HTTPS so old bookmarks still work.
:80 {
	redir https://{host}{uri} permanent
}
