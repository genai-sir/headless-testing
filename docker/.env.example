# Copy to docker/.env and fill in. .env is gitignored.

# Custom redroid image with Magisk + MindTheGApps baked in.
#
# For dev / single-host setups: a local tag works.
#   Build with: sudo scripts/build-redroid-image.sh
# REDROID_IMAGE=redroid/redroid:14.0.0_64only_mindthegapps_magisk
#
# For production: pin by sha256 digest so rebuilds are deterministic and
# `docker compose pull` actually fetches a known-good image.
#   Push with: sudo scripts/push-redroid-image.sh   (prints the line below)
REDROID_IMAGE=ghcr.io/genai-sir/headless-redroid@sha256:REPLACE_ME_AFTER_FIRST_PUSH

# Optional port overrides (defaults shown). Bind to 127.0.0.1 if you want the
# host ports unreachable from the LAN and reverse-proxied at the NAS/router.
#   BACKEND_HOST_PORT=127.0.0.1:3000
#   WS_SCRCPY_HOST_PORT=127.0.0.1:8000

# Optional redroid display tunables.
# REDROID_FPS=60
# REDROID_HEIGHT=1920
# REDROID_WIDTH=1080

# Optional: enable the health monitor sidecar.
# Start with: docker compose --profile monitor up -d
# Webhook is required; the rest have defaults.
# MONITOR_WEBHOOK_URL=https://hooks.slack.com/services/...
# MONITOR_INSTANCE_NAME=nas-redroid
# MONITOR_POLL_INTERVAL=30
# MONITOR_FAIL_THRESHOLD=3
