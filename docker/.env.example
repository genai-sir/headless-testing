# Copy to docker/.env and fill in. .env is gitignored.

# Custom redroid image with Magisk + MindTheGApps baked in.
# Build with: sudo scripts/build-redroid-image.sh
REDROID_IMAGE=redroid/redroid:14.0.0_64only_mindthegapps_magisk

# Edge (Caddy) basic-auth credentials.
# Username is cleartext; password must be the bcrypt hash from:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<your-password>'
#
# IMPORTANT: every $ in the bcrypt hash must be doubled ($$) so docker-compose
# does not interpret it as a variable reference. caddy hash-password emits a
# single-$ hash; escape it before pasting here.
AUTH_USER=admin
AUTH_HASHED_PASS=$$2a$$14$$REPLACE_ME_WITH_DOUBLED_DOLLAR_BCRYPT_HASH

# Optional port overrides (defaults shown).
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443
# WS_SCRCPY_PUBLIC_PORT=8443

# Optional redroid display tunables.
# REDROID_FPS=60
# REDROID_HEIGHT=1920
# REDROID_WIDTH=1080

# Optional: enable the health monitor sidecar.
# Start with: docker compose --profile monitor up -d
# Webhook is required; the rest have defaults.
# MONITOR_WEBHOOK_URL=https://hooks.slack.com/services/...
# MONITOR_INSTANCE_NAME=nas-redroid
# MONITOR_POLL_INTERVAL=30
# MONITOR_FAIL_THRESHOLD=3
